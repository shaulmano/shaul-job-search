# Local and cloud runs both write seen_jobs.json concurrently. On a conflict,
# take the union of both sides (a superset of "seen" URLs) instead of failing
# the push -- losing a URL just risks a duplicate notification, which is far
# cheaper than a failed run.
seen_jobs.json merge=union

# jobs.jsonl is written by the same two writers and gets the same treatment.
# It is JSONL precisely so a union merge is safe: every line stands alone, a
# duplicated record collapses on load because later lines win by id, and a
# torn line is skipped instead of taking the file down with it.
jobs.jsonl merge=union
